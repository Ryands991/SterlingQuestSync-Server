{
  "name": "sterling-quest-sync-server",
  "version": "0.1.0",
  "description": "Sterling Quest Sync server: a Cloudflare Worker and D1 database that carry Sterling Quest Tracker's offline sync between friends.",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -p . && tsc -p scripts",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "migrate": "wrangler d1 migrations apply sterling-quest-sync --remote",
    "admin": "tsx scripts/admin.ts"
  },
  "license": "MIT",
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.8.2",
    "@cloudflare/workers-types": "^5.20261115.1",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "~4.1.0",
    "wrangler": "^4.162.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "esbuild@0.28.2": true,
    "workerd@1.20260815.1": true,
    "workerd@1.20261113.1": true
  },
  "private": true,
  "type": "module"
}